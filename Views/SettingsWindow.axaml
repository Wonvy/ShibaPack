<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShibaPack.ViewModels"
        xmlns:services="using:ShibaPack.Services"
        xmlns:converters="using:ShibaPack.Converters"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:materialIconsEnum="clr-namespace:Material.Icons;assembly=Material.Icons"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
        x:Class="ShibaPack.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Localization[SettingsTitle]}"
        Width="700" Height="550"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        MinWidth="600" MinHeight="450"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <converters:EqualityConverter x:Key="EqualityConverter"/>
            <converters:PlatformDisplayConverter x:Key="PlatformDisplayConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Design.DataContext>
        <vm:SettingsViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- 窗口圆角 -->
        <Style Selector="Window">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        
        <!-- 设置窗口按钮样式 -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}"/>
        </Style>
        
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}"/>
        </Style>
        
        <!-- TextBox 样式 -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        
        <!-- ToggleSwitch 样式 -->
        <Style Selector="ToggleSwitch">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
    </Window.Styles>

    <!-- 主容器：带圆角和投影 -->
    <Border Name="MainContainer"
            Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
            CornerRadius="8"
            ClipToBounds="False"
            Loaded="MainContainer_Loaded">
        <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="200,*" Margin="0">
        
        <!-- 自定义标题栏 -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                Name="TitleBar"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Height="40"
                CornerRadius="8,8,0,0"
                PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="*,Auto">
                <Grid Grid.Column="0" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Localization[SettingsTitle]}" 
                               FontSize="13"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </Grid>
                <StackPanel Grid.Column="1" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Right">
                    <Button Name="CloseButton"
                            Width="46" Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Click="CloseButton_Click">
                        <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.WindowClose}"
                                                    Width="12" Height="12"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- 左侧导航栏 -->
        <Border Name="NavPane"
                Grid.Row="1" Grid.Column="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <ListBox Name="NavigationListBox"
                     ItemsSource="{Binding SettingsCategories}"
                     SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Name="ItemBorder"
                                Padding="12,8"
                                Margin="8,2"
                                CornerRadius="4"
                                Background="Transparent">
                            <TextBlock Name="ItemText"
                                       Text="{Binding}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected Border#ItemBorder">
                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected TextBlock#ItemText">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Medium"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover Border#ItemBorder">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected:pointerover Border#ItemBorder">
                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                    </Style>
                </ListBox.Styles>
            </ListBox>
        </Border>
        
        <!-- 右侧内容区域 -->
        <ScrollViewer Name="ContentScrollViewer"
                      Grid.Row="1" Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24" Spacing="0">
                
                <!-- 外观 -->
                <StackPanel Name="AppearanceSection" Margin="0,0,0,24">
                    <TextBlock Text="{Binding Localization[Appearance], FallbackValue='外观'}" 
                               FontSize="16" 
                               FontWeight="Medium"
                               Margin="0,0,0,16"/>
                    
                    <!-- 语言选择 -->
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,0,0,16">
                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                   Text="{Binding Localization[Language]}" 
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  SelectedItem="{Binding SelectedLanguage}">
                            <ComboBox.ItemsSource>
                                <Binding Path="AvailableLanguages"/>
                            </ComboBox.ItemsSource>
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="services:LanguageOption">
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{Binding Localization[LanguageDesc]}" 
                                   FontSize="10" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </Grid>
                    
                    <!-- 深色模式 -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding Localization[DarkMode]}" FontSize="12"/>
                            <TextBlock Text="{Binding Localization[DarkModeDesc]}" 
                                       FontSize="10" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" 
                                      IsChecked="{Binding IsDarkMode}"
                                      VerticalAlignment="Center"/>
                    </Grid>
                    
                    <!-- 毛玻璃效果 -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0">
                        <StackPanel>
                            <TextBlock Text="{Binding Localization[AcrylicEffect]}" FontSize="12"/>
                            <TextBlock Text="{Binding Localization[AcrylicEffectDesc]}" 
                                       FontSize="10" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" 
                                      IsChecked="{Binding EnableAcrylic}"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
                
                <!-- 分隔线 -->
                <Separator Margin="0,0,0,24" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>
                
                <!-- 存储 -->
                <StackPanel Name="StorageSection" Margin="0,0,0,24">
                    <TextBlock Text="{Binding Localization[Storage], FallbackValue='存储'}" 
                               FontSize="16" 
                               FontWeight="Medium"
                               Margin="0,0,0,16"/>
                    
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0">
                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                   Text="{Binding Localization[PackageStoragePath]}" 
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto,Auto">
                            <TextBox Grid.Column="0" 
                                     Text="{Binding PackageRootPath}" 
                                     IsReadOnly="True"
                                     Watermark="{Binding Localization[NotSet]}"/>
                            <Button Grid.Column="1" 
                                    Content="{Binding Localization[Browse]}"
                                    Command="{Binding SelectFolderCommand}"
                                    Margin="8,0,0,0"
                                    Padding="12,6"/>
                            <Button Grid.Column="2" 
                                    Content="{Binding Localization[Open]}"
                                    Command="{Binding OpenFolderCommand}"
                                    Margin="8,0,0,0"
                                    Padding="12,6"
                                    IsEnabled="{Binding PackageRootPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </Grid>
                    </Grid>
                </StackPanel>
                
                <!-- 分隔线 -->
                <Separator Margin="0,0,0,24" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>
                
                <!-- 行为 -->
                <StackPanel Name="BehaviorSection" Margin="0,0,0,24">
                    <TextBlock Text="{Binding Localization[Behavior], FallbackValue='行为'}" 
                               FontSize="16" 
                               FontWeight="Medium"
                               Margin="0,0,0,16"/>
                    
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding Localization[SmartCategory]}" FontSize="12"/>
                            <TextBlock Text="{Binding Localization[SmartCategoryDesc]}" 
                                       FontSize="10" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" 
                                      IsChecked="{Binding AutoOrganize}"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Margin="0" Spacing="8">
                        <TextBlock Text="{Binding Localization[DragFileMode]}" FontSize="12" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,0">
                            <RadioButton Content="{Binding Localization[CopyFile]}" 
                                        IsChecked="{Binding IsCopyFileOnImport}"
                                        GroupName="FileImportMode"/>
                            <RadioButton Content="{Binding Localization[MoveFile]}" 
                                        IsChecked="{Binding IsMoveFileOnImport}"
                                        GroupName="FileImportMode"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Localization[DragFileModeDesc]}" 
                                   FontSize="10" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- 分隔线 -->
                <Separator Margin="0,0,0,24" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>
                
                <!-- 平台文件后缀 -->
                <StackPanel Name="PlatformExtensionsSection" Margin="0,0,0,24">
                    <TextBlock Text="平台文件后缀" 
                               FontSize="16" 
                               FontWeight="Medium"
                               Margin="0,0,0,8"/>
                    
                    <TextBlock Text="为不同平台配置文件后缀标签，用于识别安装包并自动分类到对应文件夹。多个后缀用逗号分隔" 
                               FontSize="10" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,12"
                               TextWrapping="Wrap"/>
                    
                    <!-- Windows 平台 -->
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                        <TextBlock Grid.Column="0"
                                   Text="Windows:"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   MinWidth="80"
                                   Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding WindowsExtensions}"
                                 Watermark="例如：exe,msi,msix"
                                 Padding="8,4"/>
                    </Grid>
                    
                    <!-- macOS 平台 -->
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                        <TextBlock Grid.Column="0"
                                   Text="macOS:"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   MinWidth="80"
                                   Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding MacExtensions}"
                                 Watermark="例如：dmg,pkg,app"
                                 Padding="8,4"/>
                    </Grid>
                    
                    <!-- Linux 平台 -->
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,0">
                        <TextBlock Grid.Column="0"
                                   Text="Linux:"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   MinWidth="80"
                                   Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding LinuxExtensions}"
                                 Watermark="例如：deb,rpm,AppImage"
                                 Padding="8,4"/>
                    </Grid>
                </StackPanel>
                
                <!-- 分隔线 -->
                <Separator Margin="0,0,0,24" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>
                
                <!-- 缓存 -->
                <StackPanel Name="CacheSection" Margin="0,0,0,24">
                    <TextBlock Text="{Binding Localization[Cache], FallbackValue='缓存'}" 
                               FontSize="16" 
                               FontWeight="Medium"
                               Margin="0,0,0,16"/>
                    
                    <Grid ColumnDefinitions="*,Auto" Margin="0">
                        <StackPanel>
                            <TextBlock Text="{Binding Localization[IconCache]}" FontSize="12"/>
                            <TextBlock Text="{Binding Localization[IconCacheDesc]}" 
                                       FontSize="10" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" 
                                Content="{Binding Localization[ClearCache]}"
                                Command="{Binding ClearIconCacheCommand}"
                                Padding="12,6"
                                VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
                
                <!-- 分隔线 -->
                <Separator Margin="0,0,0,24" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>
                
                <!-- 数据 -->
                <StackPanel Name="DataSection" Margin="0">
                    <TextBlock Text="{Binding Localization[Data]}" 
                               FontSize="16" 
                               FontWeight="Medium"
                               Margin="0,0,0,16"/>
                    
                    <!-- 导出数据 -->
                    <StackPanel Spacing="8" Margin="0,0,0,20">
                        <TextBlock Text="{Binding Localization[ExportData]}" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Text="{Binding Localization[ExportDataDesc]}" 
                                   FontSize="10" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding Localization[ExportData]}" 
                                    Command="{Binding ExportDataCommand}"
                                    Padding="12,6"/>
                            <Button Content="{Binding Localization[ImportData]}" 
                                    Command="{Binding ImportDataCommand}"
                                    Padding="12,6"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 完整备份 -->
                    <StackPanel Spacing="8" Margin="0">
                        <TextBlock Text="{Binding Localization[FullBackup]}" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Text="{Binding Localization[FullBackupDesc]}" 
                                   FontSize="10" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding Localization[ExportBackup]}" 
                                    Command="{Binding ExportFullBackupCommand}"
                                    Padding="12,6"/>
                            <Button Content="{Binding Localization[ImportBackup]}" 
                                    Command="{Binding ImportFullBackupCommand}"
                                    Padding="12,6"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部状态栏 -->
        <Border Name="BottomBar"
                Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                CornerRadius="0,0,8,8"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <TextBlock Text="{Binding StatusMessage}" 
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       FontSize="11"/>
        </Border>
        </Grid>
    </Border>
</Window>
