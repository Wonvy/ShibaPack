<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShibaPack.ViewModels"
        xmlns:converters="using:ShibaPack.Converters"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:materialIconsEnum="clr-namespace:Material.Icons;assembly=Material.Icons"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="ShibaPack.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Localization[WindowTitle]}"
        Width="1000" Height="700"
        MinWidth="800" MinHeight="600"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <converters:IconNameToMaterialIconKindConverter x:Key="IconConverter"/>
            <converters:EqualityConverter x:Key="EqualityConverter"/>
            <converters:InstalledCategoryBorderConverter x:Key="InstalledCategoryBorderConverter"/>
            <converters:InstalledCategoryMarginConverter x:Key="InstalledCategoryMarginConverter"/>
            <converters:SortDirectionToIconConverter x:Key="SortDirectionToIconConverter"/>
            <converters:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    
    <Window.Styles>
        <!-- 窗口圆角 -->
        <Style Selector="Window">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        
        <!-- 简洁风格样式 -->
        
        <!-- TreeViewItem 选中时 MaterialIcon 样式 -->
        <Style Selector="TreeViewItem:selected Border#ItemBorder Grid materialIcons|MaterialIcon#ItemIcon">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <!-- 按钮样式 - 无边框，简洁悬停 -->
        <Style Selector="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        
        <!-- 默认按钮悬停/按下背景（表头按钮除外） -->
        <Style Selector="Button:pointerover:not(.HeaderButton)">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        </Style>
        
        <Style Selector="Button:pressed:not(.HeaderButton)">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
        </Style>
        
        <!-- 表头按钮：hover 不显示背景，只变更文字/图标颜色 -->
        <Style Selector="Button.HeaderButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.HeaderButton:pointerover">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- 覆盖主题模板可能绘制的 hover 背景 -->
        <Style Selector="Button.HeaderButton:pointerover /template/ Border">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.HeaderButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.HeaderButton:pointerover TextBlock">
            <Setter Property="Foreground" Value="#0078D4"/>
        </Style>
        <Style Selector="Button.HeaderButton:pointerover materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="#0078D4"/>
        </Style>
        
        <!-- TextBox 样式 - 简化边框 -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}"/>
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource SelectionForegroundBrush}"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        
        <!-- TextBox 焦点状态 - 移除焦点轮廓 -->
        <Style Selector="TextBox:focus">
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        
        <!-- 搜索框 TextBox 特殊样式 - 确保无焦点边框 -->
        <Style Selector="TextBox#SearchTextBox">
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <Style Selector="TextBox#SearchTextBox:focus">
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ComboBox 样式 - 简化 -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <!-- ComboBox 下拉菜单样式 -->
        <Style Selector="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        
        <Style Selector="ComboBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        </Style>
        
        <Style Selector="ComboBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
        </Style>
        
        <!-- ContextMenu 样式 -->
        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style Selector="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        
        <Style Selector="MenuItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        </Style>
        
        <Style Selector="MenuItem:selected">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
        </Style>
        
        <!-- MenuFlyout 中的 MenuItem 会自动继承上面的 MenuItem 样式 -->
        
        <!-- ToggleButton 选中状态样式 - 简化 -->
        <Style Selector="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        
        <!-- 注意：TreeExpander/VersionExpander 这类纯图标按钮不需要“选中底色” -->
        <Style Selector="ToggleButton:checked:not(.TreeExpander):not(.VersionExpander)">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        </Style>
        
        <!-- MaterialIcon 样式在具体控件中设置 -->
    </Window.Styles>

    <!-- 设计期 DataContext 已注释，避免 IO 操作导致预览器崩溃 -->
    <!--<Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>-->
    
    <!-- 主容器：Linear/Raycast 风格 -->
    <Border Name="MainContainer"
            Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0">
        
        <!-- 自定义标题栏 -->
        <Border Grid.Row="0"
                Name="TitleBar"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Height="40"
                CornerRadius="8,8,0,0"
                PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="*,Auto">
                <Grid Grid.Column="0" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Localization[WindowTitle]}" 
                               FontSize="13"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </Grid>
                <StackPanel Grid.Column="1" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Right">
                    <Button Name="MinimizeButton"
                            Width="46" Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Click="MinimizeButton_Click">
                        <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.WindowMinimize}"
                                                    Width="12" Height="12"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Button>
                    <Button Name="MaximizeButton"
                            Width="46" Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Click="MaximizeButton_Click">
                        <Panel>
                            <materialIcons:MaterialIcon Name="MaximizeIcon"
                                                        Kind="{x:Static materialIconsEnum:MaterialIconKind.WindowMaximize}"
                                                        Width="12" Height="12"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <materialIcons:MaterialIcon Name="RestoreIcon"
                                                        Kind="{x:Static materialIconsEnum:MaterialIconKind.WindowRestore}"
                                                        Width="12" Height="12"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        IsVisible="False"/>
                        </Panel>
                    </Button>
                    <Button Name="CloseButton"
                            Width="46" Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Click="CloseButton_Click">
                        <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.WindowClose}"
                                                    Width="12" Height="12"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- 顶部工具栏: 简洁风格 -->
        <Border Name="TopToolbar"
                Grid.Row="1" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                Padding="16,12" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="0,0,0,1"
                Height="0"
                IsVisible="False"/>

        <!-- 主内容区 -->
        <Grid Grid.Row="2" ColumnDefinitions="240,Auto,*" >
            
            <!-- 左侧分类列表: 简洁风格 -->
            <Border Name="LeftPane"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    Margin="0" 
                    CornerRadius="0"
                    Padding="10">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 分类标题 - 简化 -->
                    <Border Padding="12,10,12,12" 
                            Margin="0,0,0,6">
                        <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                            <TextBlock Text="分类" 
                                       FontWeight="Medium" 
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Button Grid.Column="1" 
                                    Command="{Binding RefreshCommand}"
                                    Width="24" Height="24"
                                    Padding="0"
                                    CornerRadius="6"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTip.Tip="{Binding Localization[Refresh], FallbackValue='Refresh'}">
                                <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.Refresh}"
                                                            Width="14" Height="14"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Button>
                            <Button Grid.Column="2" 
                                    Command="{Binding AddCategoryCommand}"
                                    Width="24" Height="24"
                                    Padding="0"
                                    CornerRadius="6"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTip.Tip="添加分类">
                                <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.Plus}"
                                                            Width="14" Height="14"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <!-- 分类列表-->
                    <TreeView Name="CategoryTreeView"
                              Grid.Row="1" 
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                              Background="Transparent"
                              Padding="4">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                <!-- 仅负责展示内容；命中/hover/右键菜单交给模板里的 SelectionBorder -->
                                <Grid Name="ItemRoot"
                                      ColumnDefinitions="Auto,*,Auto"
                                      IsHitTestVisible="False">
                                    <materialIcons:MaterialIcon Grid.Column="0"
                                                               Name="ItemIcon"
                                                               Kind="{Binding Icon, Converter={StaticResource IconConverter}}"
                                                               Width="16" Height="16"
                                                               Margin="0,0,8,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" 
                                               Name="ItemText"
                                               Text="{Binding Name, FallbackValue=''}" 
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="2" 
                                               Name="ItemCount"
                                               Text="{Binding SoftwareCount, FallbackValue=0}" 
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Margin="8,0,0,0"/>
                                </Grid>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                        
                        <TreeView.Styles>
                            <!-- 自定义 TreeViewItem 模板：只有一个圆角背景层（SelectionBorder），彻底消除整行直角矩形 -->
                            <Style Selector="TreeViewItem">
                                <!-- 默认：不使用 Fluent 的选中背景，背景由 SelectionBorder 控制 -->
                                <!-- 用极低 alpha 的背景确保命中测试稳定（否则 hover 可能只在边缘闪一下） -->
                                <Setter Property="Background" Value="#01000000"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Margin" Value="0,1,0,0"/>
                                <!-- 默认展开，但允许用户折叠（本地值会覆盖 Setter） -->
                                <Setter Property="IsExpanded" Value="True"/>
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <StackPanel>
                                            <Border Name="SelectionBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8"
                                        Padding="10,7" 
                                        DragDrop.AllowDrop="True"
                                                    Tag="{Binding}"
                                                    PointerPressed="CategorySelectionBorder_PointerPressed">
                                    <Border.Transitions>
                                        <Transitions>
                                            <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                        </Transitions>
                                    </Border.Transitions>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="添加子分类" 
                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AddSubCategoryCommand}" 
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.Plus}" 
                                                                                Width="16" Height="16"
                                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="编辑分类" 
                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).EditCategoryCommand}" 
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.Pencil}" 
                                                                                Width="16" Height="16"
                                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="更换图标" 
                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ChangeCategoryIconCommand}" 
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.ImageEdit}" 
                                                                                Width="16" Height="16"
                                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="删除分类" 
                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteCategoryCommand}" 
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.Delete}" 
                                                                                Width="16" Height="16" 
                                                                                Foreground="#F44336"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                                <!-- 固定预留展开箭头空间：所有条目左侧对齐 -->
                                                <Grid ColumnDefinitions="16,*">
                                                    <!-- 展开/折叠按钮：仅在有子项时显示 -->
                                                    <ToggleButton Classes="TreeExpander"
                                                                  Grid.Column="0"
                                                                  IsVisible="{Binding ItemCount, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource GreaterThanZeroConverter}}"
                                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                  Background="Transparent"
                                                                  BorderThickness="0"
                                                                  BorderBrush="Transparent"
                                                                  CornerRadius="0"
                                                                  Padding="0"
                                                                  Width="14" Height="14"
                                                                  Margin="0"
                                                                   VerticalAlignment="Center"
                                                                  HorizontalAlignment="Center">
                                                        <Grid>
                                                            <materialIcons:MaterialIcon Name="ChevronRight"
                                                                                        Kind="{x:Static materialIconsEnum:MaterialIconKind.ChevronRight}"
                                                                                        Width="12" Height="12"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <materialIcons:MaterialIcon Name="ChevronDown"
                                                                                        Kind="{x:Static materialIconsEnum:MaterialIconKind.ChevronDown}"
                                                                                        Width="12" Height="12"
                                                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </Grid>
                                                    </ToggleButton>

                                                    <ContentPresenter Grid.Column="1"
                                                                      Name="PART_HeaderPresenter"
                                                                      Content="{TemplateBinding Header}"
                                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                                      IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>

                                            <ItemsPresenter Name="PART_ItemsPresenter"
                                                            Margin="20,0,0,0"
                                                            IsVisible="{TemplateBinding IsExpanded}"/>
                                        </StackPanel>
                                    </ControlTemplate>
                                </Setter>
                            </Style>
                            
                            <!-- TreeExpander：不走全局 ToggleButton 选中高亮，保持纯图标 -->
                            <Style Selector="ToggleButton.TreeExpander">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="CornerRadius" Value="0"/>
                                <Setter Property="Template">
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"
                                                BorderThickness="0"
                                                BorderBrush="Transparent"
                                                CornerRadius="0">
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter>
                            </Style>
                            <Style Selector="ToggleButton.TreeExpander:pointerover">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="CornerRadius" Value="0"/>
                            </Style>
                            <Style Selector="ToggleButton.TreeExpander:pressed">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="CornerRadius" Value="0"/>
                            </Style>
                            <Style Selector="ToggleButton.TreeExpander:checked">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="CornerRadius" Value="0"/>
                            </Style>
                            <Style Selector="ToggleButton.TreeExpander:checked:pointerover">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="CornerRadius" Value="0"/>
                            </Style>
                            <Style Selector="ToggleButton.TreeExpander:checked:pressed">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="CornerRadius" Value="0"/>
                            </Style>
                            <!-- 展开箭头状态：默认显示右箭头，展开时显示下箭头 -->
                            <Style Selector="ToggleButton.TreeExpander materialIcons|MaterialIcon#ChevronDown">
                                <Setter Property="IsVisible" Value="False"/>
                            </Style>
                            <Style Selector="ToggleButton.TreeExpander:checked materialIcons|MaterialIcon#ChevronDown">
                                <Setter Property="IsVisible" Value="True"/>
                            </Style>
                            <Style Selector="ToggleButton.TreeExpander:checked materialIcons|MaterialIcon#ChevronRight">
                                <Setter Property="IsVisible" Value="False"/>
                            </Style>
                            
                            <!-- hover：用 TreeViewItem:pointerover 驱动，但把颜色落在 SelectionBorder 上（避免命中差异导致闪烁） -->
                            <Style Selector="TreeViewItem:not(:selected):pointerover Border#SelectionBorder">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Style>
                            
                            <!-- selected：由 TreeViewItem.Background 驱动，SelectionBorder 通过 TemplateBinding 显示 -->
                            <Style Selector="TreeViewItem:selected">
                                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            </Style>
                            
                            <!-- 选中时的文本颜色 - 亮色主题下使用白色 -->
                            <Style Selector="TreeViewItem:selected TextBlock#ItemText">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                            </Style>
                            
                            <!-- 选中时的数量颜色 - 亮色主题下使用白色（半透明） -->
                            <Style Selector="TreeViewItem:selected TextBlock#ItemCount">
                                <Setter Property="Foreground" Value="#E0FFFFFF"/>
                            </Style>
                            
                            <!-- 选中时图标颜色 -->
                            <Style Selector="TreeViewItem:selected materialIcons|MaterialIcon#ItemIcon">
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                            
                            <!-- "已安装"分类项下方添加分割线：由 MarginConverter/BorderConverter 控制 -->
                        </TreeView.Styles>
                    </TreeView>
                    
                    <!-- 重置分类按钮 - 简化 -->
                    <Button Grid.Row="2" 
                            Command="{Binding ResetCategoriesCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="6,6,6,0"
                            Padding="10,6"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                            <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.Refresh}"
                                                        Width="12" Height="12"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="重置默认分类" FontSize="11" 
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            
            <!-- 拖拽分隔条 -->
            <GridSplitter Grid.Column="1" 
                          Width="1"
                          MinWidth="1"
                          MaxWidth="1"
                          Background="{DynamicResource CardStrokeColorDefaultBrush}"
                          ResizeDirection="Columns"
                          ResizeBehavior="{x:Static GridResizeBehavior.PreviousAndNext}">
                <GridSplitter.Styles>
                    <Style Selector="GridSplitter">
                        <Setter Property="Background" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </GridSplitter.Styles>
            </GridSplitter>

            <!-- 右侧软件列表: 简洁风格 -->
            <Border Name="RightPane"
                    Grid.Column="2" 
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    Margin="0" 
                    CornerRadius="0"
                    Padding="14"
                    DragDrop.AllowDrop="True">
                <Grid RowDefinitions="Auto,Auto,*">
                    <!-- 软件列表标题 - 简化 -->
                    <Border Padding="14,8,14,8" 
                            Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedCategory.Name, FallbackValue=所有软件}" 
                                       FontWeight="Medium" 
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <!-- 搜索框 - 移动到标题右侧 -->
                            <Border Name="SearchBoxBorder"
                                    Grid.Column="1" 
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    CornerRadius="6" 
                                    Height="32"
                                    BorderThickness="0"
                                    MinWidth="300"
                                    MaxWidth="400"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0"
                                    Padding="10,0">
                                <Grid ColumnDefinitions="Auto,*">
                                    <materialIcons:MaterialIcon Grid.Column="0"
                                                                Kind="{x:Static materialIconsEnum:MaterialIconKind.Magnify}"
                                                                Width="16" Height="16"
                                                                Margin="0,0,8,0"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBox Grid.Column="1"
                                             Name="SearchTextBox"
                                             Text="{Binding SearchText}" 
                                             Watermark="{Binding Localization[SearchPlaceholder], FallbackValue='Search...'}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             VerticalAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Padding="0,0,0,0"
                                             FocusAdorner="{x:Null}"/>
                        </Grid>
                    </Border>
                    
                            <!-- 视图切换 - 移到搜索框右边 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                <ToggleButton Width="32" Height="32"
                                        Padding="6"
                                        ToolTip.Tip="列表视图"
                                        Command="{Binding SetListViewCommand}"
                                        CommandParameter="True"
                                              IsChecked="{Binding IsListView}">
                                    <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.FormatListBulleted}"
                                                                Width="16" Height="16"
                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </ToggleButton>
                                <ToggleButton Width="32" Height="32"
                                        Padding="6"
                                        ToolTip.Tip="网格视图"
                                        Command="{Binding SetListViewCommand}"
                                        CommandParameter="False"
                                              IsChecked="{Binding !IsListView}">
                                    <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.ViewGrid}"
                                                                Width="16" Height="16"
                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </ToggleButton>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    
                    <!-- 软件列表（重要：不要再用外层 ScrollViewer 包 ListBox，否则会禁用虚拟化导致滚动卡顿） -->
                    <Grid Grid.Row="2" RowDefinitions="Auto,*">
                            <!-- 列表视图列标题 -->
                            <Border Grid.Row="0"
                                    Padding="20,8,20,8"
                                    Margin="0,0,0,4"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1"
                                    IsVisible="{Binding ShowPackageList, FallbackValue=True}">
                                <Grid Name="ColumnHeaderGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="36"/>
                                        <ColumnDefinition Width="4"/> <!-- GridSplitter列 -->
                                        <ColumnDefinition Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NameColumnWidth}" MinWidth="150"/>
                                        <ColumnDefinition Width="4"/> <!-- GridSplitter列 -->
                                        <ColumnDefinition Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).VersionColumnWidth}" MinWidth="80"/>
                                        <ColumnDefinition Width="4"/> <!-- GridSplitter列 -->
                                        <ColumnDefinition Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PlatformColumnWidth}" MinWidth="80"/>
                                        <ColumnDefinition Width="4"/> <!-- GridSplitter列 -->
                                        <ColumnDefinition Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SizeColumnWidth}" MinWidth="80"/>
                                        <ColumnDefinition Width="4"/> <!-- GridSplitter列 -->
                                        <ColumnDefinition Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ModifiedTimeColumnWidth}" MinWidth="120"/>
                                        <ColumnDefinition Width="4"/> <!-- GridSplitter列 -->
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 空列（图标位置） -->
                                    <Border Grid.Column="0" Width="36" Margin="0,0,12,0"/>
                                    
                                    <!-- 软件名称列的分隔条 -->
                                    <GridSplitter Grid.Column="1"
                                                  Width="4"
                                                  Background="Transparent"
                                                  Cursor="SizeWestEast"
                                                  ResizeDirection="Columns"
                                                  ResizeBehavior="{x:Static GridResizeBehavior.PreviousAndNext}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  ZIndex="1"/>
                                    
                                    <!-- 软件名称 - 可排序 -->
                                    <Button Grid.Column="2"
                                            Classes="HeaderButton"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            Margin="14,0"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SortByColumnCommand}"
                                            CommandParameter="Name"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="4"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left">
                                            <TextBlock Text="软件名称"
                                                       FontSize="11"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <!-- 当前排序列：显示排序方向 -->
                                            <materialIcons:MaterialIcon Name="NameSortIcon"
                                                                        Width="12" Height="12"
                                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                        VerticalAlignment="Center"
                                                                        IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SortColumn, Converter={StaticResource EqualityConverter}, ConverterParameter=Name}">
                                                <materialIcons:MaterialIcon.Kind>
                                                    <Binding Path="$parent[Window].((vm:MainWindowViewModel)DataContext).SortAscending">
                                                        <Binding.Converter>
                                                            <converters:SortDirectionToIconConverter/>
                                                        </Binding.Converter>
                                                    </Binding>
                                                </materialIcons:MaterialIcon.Kind>
                                            </materialIcons:MaterialIcon>
                                            <!-- 悬停时显示箭头提示（如果当前不是排序列） -->
                                            <materialIcons:MaterialIcon Name="NameHoverSortIcon"
                                                                        Kind="{x:Static materialIconsEnum:MaterialIconKind.ArrowUp}"
                                                                        Width="12" Height="12"
                                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                        VerticalAlignment="Center"
                                                                        Opacity="0.4"
                                                                        IsVisible="False">
                                                <materialIcons:MaterialIcon.Styles>
                                                    <Style Selector="Button:pointerover materialIcons|MaterialIcon#NameHoverSortIcon">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </Style>
                                                </materialIcons:MaterialIcon.Styles>
                                            </materialIcons:MaterialIcon>
                                        </StackPanel>
                                    </Button>
                                    
                                    <!-- 版本列的分隔条 -->
                                    <GridSplitter Grid.Column="3"
                                                  Width="4"
                                                  Background="Transparent"
                                                  Cursor="SizeWestEast"
                                                  ResizeDirection="Columns"
                                                  ResizeBehavior="{x:Static GridResizeBehavior.PreviousAndNext}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  ZIndex="1"/>
                                    
                                    <!-- 版本 -->
                                    <TextBlock Grid.Column="4"
                                               Text="版本"
                                               FontSize="11"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Stretch"
                                               Margin="14,0"/>
                                    
                                    <!-- 平台列的分隔条 -->
                                    <GridSplitter Grid.Column="5"
                                                  Width="4"
                                                  Background="Transparent"
                                                  Cursor="SizeWestEast"
                                                  ResizeDirection="Columns"
                                                  ResizeBehavior="{x:Static GridResizeBehavior.PreviousAndNext}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  ZIndex="1"/>
                                    
                                    <!-- 平台 - 带下拉箭头 -->
                                    <StackPanel Grid.Column="6"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Stretch"
                                                Margin="14,0"
                                                Cursor="Hand">
                                        <TextBlock Text="平台"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button Name="PlatformFilterButton"
                                                Classes="HeaderButton"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="2"
                                                Width="16" Height="16"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Cursor="Hand">
                                            <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.ChevronDown}"
                                                                        Width="12" Height="12"
                                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="全部平台"
                                                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetPlatformFilterCommand}"
                                                              CommandParameter="0"/>
                                                    <MenuItem Header="Windows"
                                                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetPlatformFilterCommand}"
                                                              CommandParameter="1"/>
                                                    <MenuItem Header="macOS"
                                                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetPlatformFilterCommand}"
                                                              CommandParameter="2"/>
                                                    <MenuItem Header="Linux"
                                                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetPlatformFilterCommand}"
                                                              CommandParameter="3"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                </Button>
                            </StackPanel>
                                    
                                    <!-- 文件大小列的分隔条 -->
                                    <GridSplitter Grid.Column="7"
                                                  Width="4"
                                                  Background="Transparent"
                                                  Cursor="SizeWestEast"
                                                  ResizeDirection="Columns"
                                                  ResizeBehavior="{x:Static GridResizeBehavior.PreviousAndNext}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  ZIndex="1"/>
                                    
                                    <!-- 文件大小 - 可排序 -->
                                    <Button Grid.Column="8"
                                            Classes="HeaderButton"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            Margin="14,0"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SortByColumnCommand}"
                                            CommandParameter="Size"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="4"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left">
                                            <TextBlock Text="文件大小"
                                                       FontSize="11"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <!-- 当前排序列：显示排序方向 -->
                                            <materialIcons:MaterialIcon Name="SizeSortIcon"
                                                                        Width="12" Height="12"
                                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                        VerticalAlignment="Center"
                                                                        IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SortColumn, Converter={StaticResource EqualityConverter}, ConverterParameter=Size}">
                                                <materialIcons:MaterialIcon.Kind>
                                                    <Binding Path="$parent[Window].((vm:MainWindowViewModel)DataContext).SortAscending">
                                                        <Binding.Converter>
                                                            <converters:SortDirectionToIconConverter/>
                                                        </Binding.Converter>
                                                    </Binding>
                                                </materialIcons:MaterialIcon.Kind>
                                            </materialIcons:MaterialIcon>
                                        </StackPanel>
                                    </Button>
                                    
                                    <!-- 修改时间列的分隔条 -->
                                    <GridSplitter Grid.Column="9"
                                                  Width="4"
                                                  Background="Transparent"
                                                  Cursor="SizeWestEast"
                                                  ResizeDirection="Columns"
                                                  ResizeBehavior="{x:Static GridResizeBehavior.PreviousAndNext}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  ZIndex="1"/>
                                    
                                    <!-- 修改时间 - 可排序 -->
                                    <Button Grid.Column="10"
                                            Classes="HeaderButton"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            Margin="14,0"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SortByColumnCommand}"
                                            CommandParameter="ModifiedTime"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="4"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left">
                                            <TextBlock Text="修改时间"
                                                       FontSize="11"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <!-- 当前排序列：显示排序方向 -->
                                            <materialIcons:MaterialIcon Name="ModifiedTimeSortIcon"
                                                                        Width="12" Height="12"
                                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                        VerticalAlignment="Center"
                                                                        IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SortColumn, Converter={StaticResource EqualityConverter}, ConverterParameter=ModifiedTime}">
                                                <materialIcons:MaterialIcon.Kind>
                                                    <Binding Path="$parent[Window].((vm:MainWindowViewModel)DataContext).SortAscending">
                                                        <Binding.Converter>
                                                            <converters:SortDirectionToIconConverter/>
                                                        </Binding.Converter>
                                                    </Binding>
                                                </materialIcons:MaterialIcon.Kind>
                                            </materialIcons:MaterialIcon>
                                            <!-- 悬停时显示箭头提示 -->
                                            <materialIcons:MaterialIcon Name="ModifiedTimeHoverSortIcon"
                                                                        Kind="{x:Static materialIconsEnum:MaterialIconKind.ArrowUp}"
                                                                        Width="12" Height="12"
                                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                        VerticalAlignment="Center"
                                                                        Opacity="0.4"
                                                                        IsVisible="False">
                                                <materialIcons:MaterialIcon.Styles>
                                                    <Style Selector="Button:pointerover materialIcons|MaterialIcon#ModifiedTimeHoverSortIcon">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </Style>
                                                </materialIcons:MaterialIcon.Styles>
                                            </materialIcons:MaterialIcon>
                                        </StackPanel>
                                    </Button>
                                    
                                    <!-- 操作（空） -->
                                    <Border Grid.Column="11" Grid.ColumnSpan="3"/>
                        </Grid>
                    </Border>
                    
                            <!-- 已安装程序列表 -->
                            <Grid Grid.Row="1" RowDefinitions="Auto,*">
                                <!-- 已安装程序列表表头 -->
                                <Border Grid.Row="0"
                                        Padding="20,8,20,8"
                                        Margin="0,0,0,4"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1"
                                        IsVisible="{Binding ShowInstalledPrograms, FallbackValue=False}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                        <!-- 图标位置（空） -->
                                        <Border Grid.Column="0" Width="36" Margin="0,0,14,0"/>
                                        
                                        <!-- 安装程序 - 可排序 -->
                                        <Button Grid.Column="1"
                                                Classes="HeaderButton"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                Command="{Binding SortInstalledProgramsCommand}"
                                                CommandParameter="Name"
                                                Cursor="Hand">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="4"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left">
                                                <TextBlock Text="安装程序"
                                                           FontSize="11"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Name="InstalledNameSortIcon"
                                                                            Width="12" Height="12"
                                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                            VerticalAlignment="Center"
                                                                            IsVisible="{Binding InstalledSortColumn, Converter={StaticResource EqualityConverter}, ConverterParameter=Name}">
                                                    <materialIcons:MaterialIcon.Kind>
                                                        <Binding Path="InstalledSortAscending" Converter="{StaticResource SortDirectionToIconConverter}"/>
                                                    </materialIcons:MaterialIcon.Kind>
                                                </materialIcons:MaterialIcon>
                                            </StackPanel>
                                        </Button>
                                        
                                        <!-- 大小 - 可排序 -->
                                        <Button Grid.Column="2"
                                                Classes="HeaderButton"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                Margin="16,0"
                                                Command="{Binding SortInstalledProgramsCommand}"
                                                CommandParameter="Size"
                                                Cursor="Hand">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="4"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left">
                                                <TextBlock Text="大小"
                                                           FontSize="11"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Name="InstalledSizeSortIcon"
                                                                            Width="12" Height="12"
                                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                            VerticalAlignment="Center"
                                                                            IsVisible="{Binding InstalledSortColumn, Converter={StaticResource EqualityConverter}, ConverterParameter=Size}">
                                                    <materialIcons:MaterialIcon.Kind>
                                                        <Binding Path="InstalledSortAscending" Converter="{StaticResource SortDirectionToIconConverter}"/>
                                                    </materialIcons:MaterialIcon.Kind>
                                                </materialIcons:MaterialIcon>
                                            </StackPanel>
                                        </Button>
                                        
                                        <!-- 安装时间 - 可排序 -->
                                        <Button Grid.Column="3"
                                                Classes="HeaderButton"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                Margin="0,0,16,0"
                                                Command="{Binding SortInstalledProgramsCommand}"
                                                CommandParameter="InstallDate"
                                                Cursor="Hand">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="4"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left">
                                                <TextBlock Text="安装时间"
                                                           FontSize="11"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                                <materialIcons:MaterialIcon Name="InstalledDateSortIcon"
                                                                            Width="12" Height="12"
                                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                            VerticalAlignment="Center"
                                                                            IsVisible="{Binding InstalledSortColumn, Converter={StaticResource EqualityConverter}, ConverterParameter=InstallDate}">
                                                    <materialIcons:MaterialIcon.Kind>
                                                        <Binding Path="InstalledSortAscending" Converter="{StaticResource SortDirectionToIconConverter}"/>
                                                    </materialIcons:MaterialIcon.Kind>
                                                </materialIcons:MaterialIcon>
                                            </StackPanel>
                                        </Button>
                                        
                                        <!-- 操作（空） -->
                                        <Border Grid.Column="4" Width="38"/>
                                    </Grid>
                                </Border>
                                
                                <!-- 已安装程序列表内容（用 ListBox 保证虚拟化 + 自带滚动条，避免大量项目时卡顿） -->
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding InstalledPrograms}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                          Padding="8"
                                          IsVisible="{Binding ShowInstalledPrograms, FallbackValue=False}">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                        </Style>
                                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Name="InstalledItemBorder"
                                                Margin="0,0,0,6"
                                                Padding="12"
                                                CornerRadius="6"
                                                Background="Transparent"
                                                Cursor="Hand">
                                            <Border.Transitions>
                                                <Transitions>
                                                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                                </Transitions>
                                            </Border.Transitions>
                                            <Border.Styles>
                                                <!-- 鼠标悬停效果 -->
                                                <Style Selector="Border#InstalledItemBorder:pointerover">
                                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                </Style>
                                            </Border.Styles>
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                <!-- 图标 -->
                                                <Image Grid.Column="0"
                                                       Source="{Binding Icon, FallbackValue={x:Null}}"
                                                       Width="36" Height="36"
                                                       Margin="0,0,14,0"/>
                                                
                                                <!-- 信息 -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                    <TextBlock Text="{Binding DisplayName, FallbackValue=''}"
                                                               FontWeight="SemiBold"
                                                               FontSize="14"/>
                                                    <TextBlock FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                        <Run Text="{Binding Publisher, FallbackValue=''}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding DisplayVersion, FallbackValue=''}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                
                                                <!-- 大小 -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding SizeText, FallbackValue=''}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Stretch"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           Margin="16,0"/>
                                                
                                                <!-- 安装日期 -->
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding InstallDateText, FallbackValue=''}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Stretch"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           Margin="0,0,16,0"/>
                                                
                                                <!-- 卸载按钮 -->
                                                <Button Grid.Column="4"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).UninstallProgramCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="10"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="卸载"
                                                        Cursor="Hand">
                                                    <materialIcons:MaterialIcon Name="DeleteIcon"
                                                                                Kind="{x:Static materialIconsEnum:MaterialIconKind.Delete}"
                                                                                Width="18" Height="18"
                                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <!-- 悬停效果通过代码或全局样式处理 -->
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            
                            <!-- 列表视图 -->
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding FilteredGroups}"
                                     SelectedItem="{Binding SelectedGroup}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="8"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="ShowPackageList" FallbackValue="True"/>
                                        <Binding Path="IsListView" FallbackValue="True"/>
                                    </MultiBinding>
                                </ListBox.IsVisible>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Name="ItemBorder"
                                            Margin="0,0,0,6"
                                            Padding="12,8,12,8"
                                            CornerRadius="6"
                                            Background="Transparent"
                                            Cursor="Hand"
                                            Tapped="ListViewItem_Tapped"
                                            PointerPressed="SoftwareItem_PointerPressed"
                                            PointerEntered="SoftwareItem_PointerEntered"
                                            PointerExited="SoftwareItem_PointerExited">
                                        <Border.Transitions>
                                            <Transitions>
                                                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                            </Transitions>
                                        </Border.Transitions>
                                        <Border.Styles>
                                            <!-- 鼠标悬停效果 -->
                                            <Style Selector="Border:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                            </Style>
                                            <!-- 鼠标按下效果 -->
                                            <Style Selector="Border:pressed">
                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
                                            </Style>
                                        </Border.Styles>
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="运行">
                                                    <MenuItem.Icon>
                                                        <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.Play}"
                                                                                    Width="16" Height="16"
                                                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </MenuItem.Icon>
                                                    <MenuItem Header="运行最新版本" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RunPackageCommand}" CommandParameter="{Binding Packages[0]}"/>
                                                    <Separator/>
                                                    <MenuItem Header="选择版本运行..." ItemsSource="{Binding Packages}">
                                                        <MenuItem.ItemTemplate>
                                                            <DataTemplate>
                                                                <MenuItem Header="{Binding Version}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RunPackageCommand}" CommandParameter="{Binding}"/>
                                                            </DataTemplate>
                                                        </MenuItem.ItemTemplate>
                                                    </MenuItem>
                                                </MenuItem>
                                                <MenuItem Header="打开文件夹" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenInExplorerCommand}" CommandParameter="{Binding Packages[0]}">
                                                    <MenuItem.Icon>
                                                        <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.Folder}"
                                                                                    Width="16" Height="16"
                                                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="在资源管理器中显示" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowInExplorerCommand}" CommandParameter="{Binding Packages[0]}">
                                                    <MenuItem.Icon>
                                                        <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.Download}"
                                                                                    Width="16" Height="16"
                                                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        
                                        <StackPanel Spacing="8">
                                        <Grid Name="ItemContentGrid">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="36"/>
                                                <ColumnDefinition Width="4"/> <!-- GridSplitter列 -->
                                                <ColumnDefinition Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NameColumnWidth}" MinWidth="150"/>
                                                <ColumnDefinition Width="4"/> <!-- GridSplitter列 -->
                                                <ColumnDefinition Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).VersionColumnWidth}" MinWidth="80"/>
                                                <ColumnDefinition Width="4"/> <!-- GridSplitter列 -->
                                                <ColumnDefinition Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PlatformColumnWidth}" MinWidth="80"/>
                                                <ColumnDefinition Width="4"/> <!-- GridSplitter列 -->
                                                <ColumnDefinition Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SizeColumnWidth}" MinWidth="80"/>
                                                <ColumnDefinition Width="4"/> <!-- GridSplitter列 -->
                                                <ColumnDefinition Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ModifiedTimeColumnWidth}" MinWidth="120"/>
                                                <ColumnDefinition Width="4"/> <!-- GridSplitter列 -->
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 图标 -->
                                            <Border Grid.Column="0"
                                                    Width="36" Height="36"
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="6">
                                                <Image Source="{Binding Packages[0].Icon, FallbackValue={x:Null}}" 
                                                       Margin="5"/>
                                            </Border>
                                            
                                            <!-- 软件信息 -->
                                            <StackPanel Grid.Column="2" 
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Stretch"
                                                        Spacing="4">
                                                <DockPanel LastChildFill="True">
                                                    <!-- 多版本提示：只在 PackageCount>1 时显示 -->
                                                    <Border DockPanel.Dock="Right"
                                                            IsVisible="{Binding HasMultipleVersions, FallbackValue=False}"
                                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                            CornerRadius="10"
                                                            Padding="8,2"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding VersionBadgeText, FallbackValue=''}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   TextWrapping="NoWrap"/>
                                                    </Border>

                                                <TextBlock Text="{Binding Name, FallbackValue=''}" 
                                                           FontWeight="Medium"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap"/>
                                                </DockPanel>
                                                <TextBlock FontSize="11" 
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Text="{Binding Description, FallbackValue=''}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"/>
                                            </StackPanel>
                                            
                                            <!-- 版本号 -->
                                            <DockPanel Grid.Column="4"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Stretch"
                                                       Margin="14,0">
                                                <!-- 展开/折叠：仅多版本显示 -->
                                                <ToggleButton DockPanel.Dock="Right"
                                                              Classes="VersionExpander"
                                                              IsVisible="{Binding HasMultipleVersions, FallbackValue=False}"
                                                              IsChecked="{Binding IsGroupExpanded, Mode=TwoWay}"
                                                              Background="Transparent"
                                                              BorderThickness="0"
                                                              Padding="0"
                                                              Width="18" Height="18"
                                                              VerticalAlignment="Center"
                                                              Cursor="Hand">
                                                    <Grid>
                                                        <materialIcons:MaterialIcon Name="ChevronDown"
                                                                                    Kind="{x:Static materialIconsEnum:MaterialIconKind.ChevronDown}"
                                                                                    Width="16" Height="16"
                                                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <materialIcons:MaterialIcon Name="ChevronUp"
                                                                                    Kind="{x:Static materialIconsEnum:MaterialIconKind.ChevronUp}"
                                                                                    Width="16" Height="16"
                                                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </Grid>
                                                </ToggleButton>
                                                
                                                <TextBlock Text="{Binding LatestVersion, StringFormat=v{0}, FallbackValue=''}" 
                                                       FontSize="11" 
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       VerticalAlignment="Center"
                                                           HorizontalAlignment="Stretch"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"/>
                                            </DockPanel>
                                            
                                            <!-- 平台 - 改为列 -->
                                            <TextBlock Grid.Column="6" 
                                                       Text="{Binding PlatformsText, FallbackValue=''}" 
                                                       FontSize="11" 
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Stretch"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       Margin="14,0"/>
                                            
                                            <!-- 文件大小 -->
                                            <TextBlock Grid.Column="8" 
                                                       Text="{Binding TotalSizeText, FallbackValue=''}" 
                                                       FontSize="11" 
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Stretch"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       Margin="14,0"/>
                                            
                                            <!-- 修改时间 -->
                                            <TextBlock Grid.Column="10" 
                                                       Text="{Binding LatestModifiedTimeText, FallbackValue=''}" 
                                                       FontSize="11" 
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Stretch"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       Margin="14,0"/>
                                            
                                            <!-- 安装按钮 -->
                                            <Button Grid.Column="12"
                                                    Content="安装"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RunPackageCommand}"
                                                    CommandParameter="{Binding Packages[0]}"
                                                    Padding="12,6"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="安装"/>
                                            
                                            <!-- 打开文件夹按钮（图标） -->
                                            <Button Grid.Column="13"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenInExplorerCommand}"
                                                    CommandParameter="{Binding Packages[0]}"
                                                    Width="32" Height="32"
                                                    Padding="0"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="打开文件夹">
                                                <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.Folder}"
                                                                            Width="16" Height="16"
                                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </Button>
                                            
                                            <!-- 删除按钮（图标） -->
                                            <Button Grid.Column="14"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CleanOldVersionsCommand}"
                                                    CommandParameter="{Binding}"
                                                    Width="32" Height="32"
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="清理旧版本">
                                                <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.Delete}"
                                                                            Width="16" Height="16"
                                                                            Foreground="#F44336"/>
                                            </Button>
                                        </Grid>
                                        
                                        <!-- 多版本展开区域：列出所有版本（与表头列对齐） -->
                                        <Border IsVisible="{Binding IsGroupExpanded, FallbackValue=False}"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                CornerRadius="6"
                                                Padding="8"
                                                Margin="0,0,0,2">
                                            <ItemsControl ItemsSource="{Binding Packages}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="Transparent"
                                                                Padding="6,4"
                                                                CornerRadius="4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" MinWidth="36"/>
                                                                    <ColumnDefinition Width="4"/>
                                                                    <ColumnDefinition Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NameColumnWidth}" MinWidth="150"/>
                                                                    <ColumnDefinition Width="4"/>
                                                                    <ColumnDefinition Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).VersionColumnWidth}" MinWidth="80"/>
                                                                    <ColumnDefinition Width="4"/>
                                                                    <ColumnDefinition Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PlatformColumnWidth}" MinWidth="80"/>
                                                                    <ColumnDefinition Width="4"/>
                                                                    <ColumnDefinition Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SizeColumnWidth}" MinWidth="80"/>
                                                                    <ColumnDefinition Width="4"/>
                                                                    <ColumnDefinition Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ModifiedTimeColumnWidth}" MinWidth="120"/>
                                                                    <ColumnDefinition Width="4"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                
                                                                <!-- 小标记 -->
                                                                <materialIcons:MaterialIcon Grid.Column="0"
                                                                                           Kind="{x:Static materialIconsEnum:MaterialIconKind.SubdirectoryArrowRight}"
                                                                                           Width="16" Height="16"
                                                                                           Margin="6,0,0,0"
                                                                                           VerticalAlignment="Center"
                                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                
                                                                <!-- 文件名 -->
                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding FileName, FallbackValue=''}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="NoWrap"/>
                                                                
                                                                <!-- 版本 -->
                                                                <TextBlock Grid.Column="4"
                                                                           Text="{Binding Version, StringFormat=v{0}, FallbackValue=''}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="14,0"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="NoWrap"/>
                                                                
                                                                <!-- 平台 -->
                                                                <TextBlock Grid.Column="6"
                                                                           Text="{Binding PlatformText, FallbackValue=''}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="14,0"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="NoWrap"/>
                                                                
                                                                <!-- 大小 -->
                                                                <TextBlock Grid.Column="8"
                                                                           Text="{Binding FileSizeText, FallbackValue=''}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="14,0"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="NoWrap"/>
                                                                
                                                                <!-- 修改时间 -->
                                                                <TextBlock Grid.Column="10"
                                                                           Text="{Binding ModifiedTimeText, FallbackValue=''}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="14,0"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="NoWrap"/>
                                                                
                                                                <!-- 运行 -->
                                                                <Button Grid.Column="12"
                                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RunPackageCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Width="32" Height="32"
                                                                        Padding="0"
                                                                        Margin="0,0,8,0"
                                                                        VerticalAlignment="Center"
                                                                        ToolTip.Tip="运行/安装">
                                                                    <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.Play}"
                                                                                                Width="16" Height="16"
                                                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                </Button>
                                                                
                                                                <!-- 打开文件夹 -->
                                                                <Button Grid.Column="13"
                                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenInExplorerCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Width="32" Height="32"
                                                                        Padding="0"
                                                                        Margin="0,0,8,0"
                                                                        VerticalAlignment="Center"
                                                                        ToolTip.Tip="打开文件夹">
                                                                    <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.Folder}"
                                                                                                Width="16" Height="16"
                                                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                </Button>
                                                                
                                                                <!-- 删除 -->
                                                                <Button Grid.Column="14"
                                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeletePackageCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Width="32" Height="32"
                                                                        Padding="0"
                                                                        VerticalAlignment="Center"
                                                                        ToolTip.Tip="删除">
                                                                    <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.Delete}"
                                                                                                Width="16" Height="16"
                                                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </Button>
                                        </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Styles>
                                <!-- 隐藏默认选中背景 -->
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <!-- 选中时的 Border 样式 - 简化 -->
                                <Style Selector="ListBoxItem:selected Border#ItemBorder">
                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                </Style>
                            </ListBox.Styles>
                        </ListBox>
                        
                        <!-- 网格视图 -->
                        <ListBox Grid.Row="1"
                                 Name="GridViewListBox"
                                 ItemsSource="{Binding FilteredGroups}"
                                 SelectedItem="{Binding SelectedGroup}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="8"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PointerWheelChanged="GridViewListBox_PointerWheelChanged">
                            <ListBox.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="ShowPackageList" FallbackValue="True"/>
                                    <Binding Path="!IsListView" FallbackValue="False"/>
                                </MultiBinding>
                            </ListBox.IsVisible>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Name="GridViewWrapPanel"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GridItemWidth}"
                                            Margin="0,0,10,10"
                                            Padding="14"
                                            CornerRadius="8"
                                            Background="Transparent"
                                            Cursor="Hand"
                                            Tapped="GridViewItem_Tapped"
                                            DoubleTapped="GridViewItem_DoubleTapped"
                                            PointerPressed="SoftwareItem_PointerPressed"
                                            PointerEntered="SoftwareItem_PointerEntered"
                                            PointerExited="SoftwareItem_PointerExited">
                                        <Border.Transitions>
                                            <Transitions>
                                                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                            </Transitions>
                                        </Border.Transitions>
                                        <Border.Styles>
                                            <Style Selector="Border:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                            </Style>
                                            <Style Selector="Border:pressed">
                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
                                            </Style>
                                        </Border.Styles>
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="运行">
                                                    <MenuItem.Icon>
                                                        <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.Play}"
                                                                                    Width="16" Height="16"
                                                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </MenuItem.Icon>
                                                    <MenuItem Header="运行最新版本" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RunPackageCommand}" CommandParameter="{Binding Packages[0]}"/>
                                                    <Separator/>
                                                    <MenuItem Header="选择版本运行..." ItemsSource="{Binding Packages}">
                                                        <MenuItem.ItemTemplate>
                                                            <DataTemplate>
                                                                <MenuItem Header="{Binding Version}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RunPackageCommand}" CommandParameter="{Binding}"/>
                                                            </DataTemplate>
                                                        </MenuItem.ItemTemplate>
                                                    </MenuItem>
                                                </MenuItem>
                                                <MenuItem Header="打开文件夹" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenInExplorerCommand}" CommandParameter="{Binding Packages[0]}">
                                                    <MenuItem.Icon>
                                                        <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.Folder}"
                                                                                    Width="16" Height="16"
                                                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="在资源管理器中显示" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowInExplorerCommand}" CommandParameter="{Binding Packages[0]}">
                                                    <MenuItem.Icon>
                                                        <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.Download}"
                                                                                    Width="16" Height="16"
                                                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        
                                        <StackPanel Spacing="12">
                                            <!-- 图标 -->
                                            <Border Width="64" Height="64"
                                                    HorizontalAlignment="Center"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="8">
                                                <Image Source="{Binding Packages[0].Icon, FallbackValue={x:Null}}"
                                                       Margin="8"/>
                                            </Border>
                                            
                                            <!-- 软件名称 -->
                                            <TextBlock Text="{Binding Name, FallbackValue=''}" 
                                                       FontWeight="Medium"
                                                       FontSize="13"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="36"/>
                                            
                                            <!-- 版本信息 -->
                                            <StackPanel Spacing="4">
                                                <TextBlock FontSize="11" 
                                                           TextAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <Run Text="v"/>
                                                    <Run Text="{Binding LatestVersion, FallbackValue=''}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="10" 
                                                           TextAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                    <Run Text="{Binding PackageCount, FallbackValue=0}"/>
                                                    <Run Text="个版本"/>
                                                </TextBlock>
                                            </StackPanel>
                                            
                                            <!-- 平台标签 - 简化 -->
                                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding PlatformsText, FallbackValue=''}" 
                                                           FontSize="9"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Styles>
                                <!-- 隐藏默认选中背景 -->
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <!-- 选中时的 Border 样式 - 简化 -->
                                <Style Selector="ListBoxItem:selected Border">
                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                </Style>
                            
                            <!-- 多版本展开按钮：不走全局 ToggleButton 选中高亮 -->
                            <Style Selector="ToggleButton.VersionExpander">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                            <Style Selector="ToggleButton.VersionExpander:checked">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ToggleButton.VersionExpander materialIcons|MaterialIcon#ChevronUp">
                                <Setter Property="IsVisible" Value="False"/>
                            </Style>
                            <Style Selector="ToggleButton.VersionExpander:checked materialIcons|MaterialIcon#ChevronUp">
                                <Setter Property="IsVisible" Value="True"/>
                            </Style>
                            <Style Selector="ToggleButton.VersionExpander:checked materialIcons|MaterialIcon#ChevronDown">
                                <Setter Property="IsVisible" Value="False"/>
                                </Style>
                            </ListBox.Styles>
                        </ListBox>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

                <!-- 底部状态栏: 简洁风格 -->
        <Border Name="BottomBar"
                Grid.Row="3"
                CornerRadius="0,0,8,8" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                Padding="16,10"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="{Binding StatusMessage, FallbackValue=''}" 
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                           FontSize="11"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" Margin="0,0,12,0">
                    <TextBlock FontSize="11" 
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center">
                        <Run Text="Software: "/><Run Text="{Binding TotalSoftwareCount, FallbackValue=0}"/>
                    </TextBlock>
                    <TextBlock FontSize="11" 
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center">
                        <Run Text="Packages: "/><Run Text="{Binding TotalPackageCount, FallbackValue=0}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <!-- 主题切换按钮 -->
                    <Button Command="{Binding ToggleThemeCommand}"
                            ToolTip.Tip="切换主题"
                            Width="28" Height="28"
                            Padding="0"
                            CornerRadius="4">
                        <!-- 根据 IsDarkMode 来显示不同的图标 -->
                        <Panel>
                            <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.WeatherSunny}"
                                                        Width="14" Height="14"
                                                        IsVisible="{Binding !IsDarkMode, FallbackValue=True}"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.WeatherNight}"
                                                        Width="14" Height="14"
                                                        IsVisible="{Binding IsDarkMode, FallbackValue=False}"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Panel>
                    </Button>
                    <!-- 设置按钮 -->
                    <Button Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="{Binding Localization[Settings], FallbackValue='Settings'}"
                            Width="28" Height="28"
                            Padding="0"
                            CornerRadius="4">
                        <materialIcons:MaterialIcon Kind="{x:Static materialIconsEnum:MaterialIconKind.Cog}"
                                                    Width="14" Height="14"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
    </Border>
</Window>
