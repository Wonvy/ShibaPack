<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShibaPack.Views.ConfirmDialog"
        Title="确认"
        Width="400" Height="180"
        MinWidth="350" MinHeight="180"
        MaxWidth="500" MaxHeight="180"
        WindowStartupLocation="CenterOwner"
        CanResize="false"
        Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">
    
    <Window.Styles>
        <!-- 按钮样式 -->
        <Style Selector="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        </Style>
        
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
        </Style>
        
        <!-- 确定按钮特殊样式 -->
        <Style Selector="Button#ConfirmButton">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <Style Selector="Button#ConfirmButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <Style Selector="Button#ConfirmButton:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>
    
    <Grid RowDefinitions="*,Auto" Margin="20">
        <!-- 内容区 -->
        <StackPanel Grid.Row="0" Spacing="12" VerticalAlignment="Center">
            <TextBlock Name="MessageText" 
                       Text="确定要执行此操作吗？"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        </StackPanel>
        
        <!-- 按钮区 -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Content="取消" 
                    Width="80" 
                    Click="OnCancelClick"
                    Padding="12,6"/>
            <Button Name="ConfirmButton"
                    Content="确定" 
                    Width="80" 
                    Click="OnConfirmClick"
                    Padding="12,6"/>
        </StackPanel>
    </Grid>
</Window>

